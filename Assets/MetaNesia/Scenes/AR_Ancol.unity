  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e8c145a123943e940902c1c58aca1e54, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tracker: {fileID: 1310778119401607917}
  panelInfo: {fileID: 969930066}
  panelSize:
    _openSize: {x: 300, y: 140}
    _closeSize: {x: 300, y: 50}
  displayText:
    title: {fileID: 1470804884}
    content: {fileID: 1724387742}
  contents:
  - namaIndo: Hiu Paus
    namaEng: Whale Shark
    namaLat: Rhincodon Typus
    contentText: "\rHiu paus adalah hiu pemakan plankton yang merupakan spesies ikan
      terbesar.\r\n\r\nHiu ini mengembara di samudera tropis dan lautan yang beriklim
      hangat, dan dapat hidup hingga berusia 70 tahun. Spesies ini dipercaya berasal
      dari sekitar 60 juta tahun yang lalu.\r\n\r\nIUCN, badan konservasi dunia,
      memasukkan populasi Hiu ini ke dalam status Rentan (Vulnerable).\r"
    position: 1
  - namaIndo: Gurita
    namaEng: Octopus
    namaLat: Octupus Vulgaris
    contentText: "Gurita (Octopoda) adalah hewan moluska dari kelas Cephalopoda (kaki
      hewan terletak di kepala), dengan terumbu karang di samudra sebagai habitat
      utama. \r\n\r\nGurita terdiri dari 289 spesies yang mencakup sepertiga dari
      total spesies kelas Cephalopoda. memiliki 8 lengan (bukan tentakel) dengan
      alat pengisap berupa bulatan-bulatan cekung pada lengan yang digunakan untuk
      bergerak di dasar laut dan menangkap mangsa."
    position: 0
  OnButtonClick:
    m_PersistentCalls:
      m_Calls: []
